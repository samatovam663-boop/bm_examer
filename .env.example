# backend/.env.example -> nusxalab backend/.env deb nomlang va to'ldiring. .env gitga TUSHMASLIGI kerak.

# --- majburiy (production) ---
# Tasodifiy kalit yarating: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Sayt domenlari, vergul bilan: exam.example.uz,www.exam.example.uz
DJANGO_ALLOWED_HOSTS=

# --- rejim ---
# 1 = rivojlanish (DEBUG), standart 0. Productionda 0 qoldiring.
DJANGO_DEBUG=0

# --- HTTPS (production) ---
# Nginx/Caddy ortida bo'lsangiz 1 qiling (proxy X-Forwarded-Proto yuborishi shart). To'g'ridan-to'g'ri internetga ochiq bo'lsa 0.
DJANGO_BEHIND_PROXY=1
# HTTPS'ga yo'naltirish (standart 1). Faqat HTTP bilan sinash uchun 0.
DJANGO_SSL_REDIRECT=1
# HSTS muddati sekundda (standart 1 yil; HTTPS ishlashiga ishonch hosil qilgach)
# DJANGO_HSTS_SECONDS=31536000

# --- manzillar (frontend boshqa domenda bo'lsa) ---
# CORS_ALLOWED_ORIGINS=https://exam.example.uz
# CSRF_TRUSTED_ORIGINS=https://exam.example.uz

# --- fayllar ---
# SQLITE_PATH=/var/lib/bm_examer/db.sqlite3
# MEDIA_ROOT=/var/lib/bm_examer/media
# STATIC_ROOT=/var/www/bm_examer/static
# Yuklangan rasmlarni Django o'zi bersin (nginx bermasa). Standart: faqat DEBUG da.
# SERVE_MEDIA=1

# --- JWT va cheklovlar ---
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=7
# Refresh token httpOnly cookie'da. Secure standart: DEBUG=0 da yoqilgan (faqat HTTPS). Frontend va API bir domenda bo'lishi kerak.
# JWT_COOKIE_SECURE=1
# THROTTLE_REFRESH=60/min
# THROTTLE_LOGIN=20/min
# THROTTLE_REGISTER=20/hour
# THROTTLE_PASSWORD=10/hour

# --- Claude bilan savol yaratish (ixtiyoriy) ---
# Kalit bo'lmasa, tugma "sozlanmagan" deb xabar beradi. Kalitni https://console.anthropic.com dan oling.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# THROTTLE_AI=20/hour

# LOG_LEVEL=INFO
